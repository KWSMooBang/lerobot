#!/usr/bin/env bash
# sc-train CLI: see scripts/shortcut/train/README.md (python entry: sc_train.py).
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
# --extra shortcut-bench: --then-bench runs sc-bench (websockets, msgpack) in this interpreter
exec uv run --project "$REPO" --extra shortcut-bench python "$REPO/scripts/shortcut/train/sc_train.py" "$@"
